{
    "manifest_version": 3,
    "name": "TabNet Live Speed Monitor",
    "version": "1.2.0",
    "minimum_chrome_version": "110",
    "description": "Real-time per-tab upload and download speed monitor with an all-tabs overview.",
    "icons": {
        "16": "icons/icon16.png",
        "32": "icons/icon32.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "permissions": ["webRequest", "tabs", "storage", "scripting"],
    "host_permissions": ["<all_urls>"],
    "background": {
        "service_worker": "background.js"
    },
    "action": {
        "default_popup": "popup.html",
        "default_title": "TabNet Speed Monitor",
        "default_icon": {
            "16": "icons/icon16.png",
            "32": "icons/icon32.png",
            "48": "icons/icon48.png"
        }
    },
    "content_scripts": [
        {
            "matches": ["<all_urls>"],
            "js": ["content.js"],
            "run_at": "document_start",
            "all_frames": false,
            "match_about_blank": false
        }
    ]
}
